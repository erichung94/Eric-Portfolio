---
import { profile } from '../data/profile';

interface Props {
  scope: 'dev' | 'dance';
}

const { scope } = Astro.props;
const { email, github, linkedin, instagram } = profile.links;
---
<section id={`${scope}-contact`} class="container section">
  <h2 class="section__title">Contact</h2>
  <ul class="contact">
    <li><a href={`mailto:${email}`}>{email}</a></li>
    {scope === 'dev' && (
      <>
        <li><a href={github} target="_blank" rel="noopener">GitHub</a></li>
        <li><a href={linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      </>
    )}
    {scope === 'dance' && instagram && <li><a href={instagram} target="_blank" rel="noopener">Instagram</a></li>}
  </ul>
</section>
<style>
  .contact { list-style: none; display: flex; flex-wrap: wrap; gap: 18px; }
</style>
