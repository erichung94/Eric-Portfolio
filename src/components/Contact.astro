---
import { profile } from '../data/profile';
const { scope } = Astro.props as { scope: 'dev' | 'dance' };
const { email, github, linkedin, instagram } = profile.links;
---
<section id={`${scope}-contact`} class="container section">
  <h2 class="section__title">Contact</h2>
  <ul class="contact">
    <li><a href={`mailto:${email}`}>{email}</a></li>
    {scope === 'dev' && (
      <>
        <li><a href={github}>GitHub</a></li>
        <li><a href={linkedin}>LinkedIn</a></li>
      </>
    )}
    {scope === 'dance' && instagram && <li><a href={instagram}>Instagram</a></li>}
  </ul>
</section>
<style>
  .contact { list-style: none; display: flex; flex-wrap: wrap; gap: 18px; }
</style>
