---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DevSections from '../components/DevSections.astro';
import DanceSections from '../components/DanceSections.astro';
import type { Mode } from '../lib/mode';

interface Props {
  mode: Mode;
}

const { mode } = Astro.props;
const meta = {
  dev: {
    title: 'Eric Hung | Full-stack developer',
    description: 'I build web apps with TypeScript and Node, most recently a messaging platform and a payments product. Minneapolis based, open to new roles.',
    og: '/images/og-dev.png',
  },
  dance: {
    title: 'Eric Hung | West Coast Swing instructor',
    description: 'West Coast Swing dancer and instructor in the Twin Cities. Lessons and video coming soon.',
    og: '/images/og-dance.png',
  },
}[mode];
const canonical = new URL(mode === 'dance' ? '/dancer' : '/', Astro.site).href;
---
<!doctype html>
<html lang="en" data-mode={mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;1,9..144,400&family=JetBrains+Mono:wght@400;500;700&family=Source+Sans+3:wght@300..700&display=swap"
    />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    {/* The dance route is a holding page. Let it be reachable and shareable,
        but keep it out of search results until there is something on it. */}
    {mode === 'dance' && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(meta.og, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header mode={mode} />
    <main id="main">
      <DevSections />
      <DanceSections />
    </main>
    <Footer />
  </body>
</html>
